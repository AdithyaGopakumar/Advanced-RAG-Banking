# ─── Application ───
APP_NAME="RAG Bank"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# ─── Server ───
HOST="0.0.0.0"
PORT=8000

# ─── Auth ───
API_KEY="dev-secret-key"

# ─── CORS ───
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
ALLOWED_HEADERS=["Authorization","Content-Type","X-API-Key","X-Request-ID"]

# ─── Trusted Hosts ───
# Lock down in production: ALLOWED_HOSTS=["api.yourdomain.com"]
ALLOWED_HOSTS=["*"]

# ─── Rate Limiting ───
RATE_LIMIT="100/minute"

# ─── Logging ───
LOG_LEVEL="INFO"

# ─── AI Agent Defaults ───
DEFAULT_AGENT_TIMEOUT=30.0
DEFAULT_AGENT_RETRIES=0

# ─── Embeddings ───
# Development model. Change these if a later benchmark selects a different embedding.
EMBEDDING_PROVIDER="sentence-transformers"
EMBEDDING_MODEL="paraphrase-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384

# ─── Pinecone ───
# Leave the key and index empty to use the in-memory vector index.
# The Pinecone index must already exist: 384 dimensions, cosine metric.
# PINECONE_API_KEY=""
# PINECONE_INDEX_NAME=""
PINECONE_NAMESPACE="knowledge"
# Written only after a Pinecone index run. Relative paths are from the Backend directory.
INDEX_MANIFEST_PATH=".index/manifest.json"
